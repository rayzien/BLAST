# ==========================================================
# BLAST ENVIRONMENT CONFIGURATION
# Architecture: App -> Blast -> Supabase
# ==========================================================

# Server Host & Port
BLAST_HOST=0.0.0.0
BLAST_PORT=8080
BLAST_DEBUG=false

# Supabase Backend Target
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_TIMEOUT_SECONDS=15.0

# Blast Security Layer
BLAST_REQUIRE_API_KEY=true
BLAST_API_KEYS=blast-secret-key-1,blast-dev-key
BLAST_MAX_PAYLOAD_BYTES=10485760 # 10 MB

# Token Bucket Rate Limiting
BLAST_RATE_LIMIT_ENABLED=true
BLAST_RATE_LIMIT_RPS=20.0        # Refill tokens per second
BLAST_RATE_LIMIT_BURST=50        # Maximum burst capacity

# Durable Queue & Background Workers
BLAST_DB_PATH=blast_queue.db
BLAST_MAX_WORKERS=4
BLAST_WORKER_POLL_INTERVAL=0.2
BLAST_MAX_RETRIES=3
BLAST_INITIAL_BACKOFF_SECONDS=1.0
BLAST_BACKOFF_MULTIPLIER=2.0
